# CloudBridge — Customer B Docker environment variables
# Copy this file to .env and fill in values
# .env is gitignored — never commit it

# PostgreSQL
POSTGRES_DB=bluepeak_app
POSTGRES_USER=bluepeak_user
POSTGRES_PASSWORD=change_me_before_use

# MinIO application storage settings
S3_ENDPOINT_URL=http://minio:9000
S3_BUCKET_NAME=bluepeak-uploads
S3_REGION=us-east-1

# MinIO (S3 simulation)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_before_use
