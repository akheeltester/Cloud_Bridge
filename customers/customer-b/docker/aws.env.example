# Copy to .env.aws on the EC2 instance and set the bucket name you created.
# Do not put AWS access keys here. The app uses the EC2 instance role.
POSTGRES_DB=bluepeak_app
POSTGRES_USER=bluepeak_user
POSTGRES_PASSWORD=change_me_before_use

# Required by Compose interpolation for the disabled local-simulation service.
# This value is not passed to the AWS-mode app.
MINIO_ROOT_PASSWORD=not-used-in-aws-mode

AWS_REGION=ap-southeast-2
S3_BUCKET_NAME=replace-with-your-unique-private-bucket-name
